    <bpmn:textAnnotation id="n1"><bpmn:text>Canales: WhatsApp, Facebook, Instagram o llamada. Todo llega desordenado.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n1" sourceRef="st_msg" targetRef="n1"/>
    <bpmn:textAnnotation id="n2"><bpmn:text>Sin horario fijo: hay mensajes que se pierden o se responden tarde.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n2" sourceRef="t_rev" targetRef="n2"/>
    <bpmn:textAnnotation id="n3"><bpmn:text>Urgente: demandado con plazo, detenido o medida de protección (Ley 30364).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n3" sourceRef="t_hoy" targetRef="n3"/>
    <bpmn:textAnnotation id="n4"><bpmn:text>Persona natural: verbal o WhatsApp. Persona jurídica o entidad: cotización en Word por correo. Pro bono: honorarios S/ 0.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n4" sourceRef="t_prop" targetRef="n4"/>
    <bpmn:textAnnotation id="n5"><bpmn:text>Se hace cuando el cliente ya pagó y se retiró de la oficina.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n5" sourceRef="t_explic" targetRef="n5"/>
    <bpmn:textAnnotation id="n6"><bpmn:text>Persona jurídica: DNI del representante legal.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n6" sourceRef="t_dni" targetRef="n6"/>
    <bpmn:textAnnotation id="n7"><bpmn:text>Rol: demandante, demandado, denunciante, imputado, administrado, etc.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n7" sourceRef="t_rol" targetRef="n7"/>
