<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_P1" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_P1_0"><bpmn:categoryValue id="CV_P1_0" value="FASE A · Captación y agendamiento"/></bpmn:category>
  <bpmn:category id="Cat_P1_1"><bpmn:categoryValue id="CV_P1_1" value="FASE B · Consulta presencial"/></bpmn:category>
  <bpmn:category id="Cat_P1_2"><bpmn:categoryValue id="CV_P1_2" value="FASE C · Aceptación y apertura del caso"/></bpmn:category>
  <bpmn:process id="Proc_P1" name="P1 - Captación, Consulta y Apertura del Caso (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LS_P1">
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>st_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rubro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deriv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_noat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_datos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_buscar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prosp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_coord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_anot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_dia</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_repro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cita</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_asis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_inas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pago1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cobro1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pagado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cobro2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_p2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>par</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_ajus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_seg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pagoad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_regpago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_jur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_actu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_ficha</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_exp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ABO" name="Abogado titular">
        <bpmn:flowNodeRef>j_p1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_escu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_abs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nopat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_explic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ajus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dni</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_contr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PRA" name="Practicante">
        <bpmn:flowNodeRef>t_grab</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trans</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_drive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_carp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="st_msg" name="Consulta recibida"><bpmn:outgoing>F_st_msg_t_rev</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_msg"/></bpmn:startEvent>
    <bpmn:userTask id="t_rev" name="Revisar mensajes de WhatsApp y redes sociales"><bpmn:incoming>F_st_msg_t_rev</bpmn:incoming><bpmn:outgoing>F_t_rev_g_rubro</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_rubro" name="¿Consulta del rubro legal?"><bpmn:incoming>F_t_rev_g_rubro</bpmn:incoming><bpmn:outgoing>F_g_rubro_t_deriv</bpmn:outgoing><bpmn:outgoing>F_g_rubro_t_datos</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_deriv" name="Responder y derivar al cliente"><bpmn:incoming>F_g_rubro_t_deriv</bpmn:incoming><bpmn:outgoing>F_t_deriv_e_noat</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e_noat" name="Consulta no atendida"><bpmn:incoming>F_t_deriv_e_noat</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="t_datos" name="Solicitar nombre, tema y urgencia"><bpmn:incoming>F_g_rubro_t_datos</bpmn:incoming><bpmn:outgoing>F_t_datos_g_rec</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_rec" name="¿Cliente nuevo o recurrente?"><bpmn:incoming>F_t_datos_g_rec</bpmn:incoming><bpmn:outgoing>F_g_rec_t_buscar</bpmn:outgoing><bpmn:outgoing>F_g_rec_t_prosp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_buscar" name="Buscar ficha y casos previos en Excel"><bpmn:incoming>F_g_rec_t_buscar</bpmn:incoming><bpmn:outgoing>F_t_buscar_j_rec</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="t_prosp" name="Anotar prospecto en cuaderno"><bpmn:incoming>F_g_rec_t_prosp</bpmn:incoming><bpmn:outgoing>F_t_prosp_j_rec</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_rec"><bpmn:incoming>F_t_buscar_j_rec</bpmn:incoming><bpmn:incoming>F_t_prosp_j_rec</bpmn:incoming><bpmn:outgoing>F_j_rec_g_urg</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_urg" name="¿Caso urgente?"><bpmn:incoming>F_j_rec_g_urg</bpmn:incoming><bpmn:outgoing>F_g_urg_t_hoy</bpmn:outgoing><bpmn:outgoing>F_g_urg_t_disp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_hoy" name="Coordinar cita para el mismo día"><bpmn:incoming>F_g_urg_t_hoy</bpmn:incoming><bpmn:outgoing>F_t_hoy_j_cita</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_disp" name="Consultar disponibilidad en la agenda del abogado"><bpmn:incoming>F_g_urg_t_disp</bpmn:incoming><bpmn:outgoing>F_t_disp_t_coord</bpmn:outgoing></bpmn:manualTask>
    <bpmn:sendTask id="t_coord" name="Coordinar fecha, hora y costo de la consulta"><bpmn:incoming>F_t_disp_t_coord</bpmn:incoming><bpmn:incoming>F_m_repro_t_coord</bpmn:incoming><bpmn:outgoing>F_t_coord_t_anot</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_anot" name="Anotar cita en la agenda"><bpmn:incoming>F_t_coord_t_anot</bpmn:incoming><bpmn:outgoing>F_t_anot_tm_dia</bpmn:outgoing></bpmn:manualTask>
    <bpmn:intermediateCatchEvent id="tm_dia" name="Un día antes de la cita"><bpmn:incoming>F_t_anot_tm_dia</bpmn:incoming><bpmn:outgoing>F_tm_dia_t_recor</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_dia"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_recor" name="Recordar la cita al cliente y al abogado"><bpmn:incoming>F_tm_dia_t_recor</bpmn:incoming><bpmn:outgoing>F_t_recor_ebg1</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="ebg1"><bpmn:incoming>F_t_recor_ebg1</bpmn:incoming><bpmn:outgoing>F_ebg1_m_conf</bpmn:outgoing><bpmn:outgoing>F_ebg1_m_repro</bpmn:outgoing><bpmn:outgoing>F_ebg1_m_canc</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_conf" name="Cliente confirma"><bpmn:incoming>F_ebg1_m_conf</bpmn:incoming><bpmn:outgoing>F_m_conf_j_cita</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_conf"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_repro" name="Cliente pide reprogramar"><bpmn:incoming>F_ebg1_m_repro</bpmn:incoming><bpmn:outgoing>F_m_repro_t_coord</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_repro"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_canc" name="Cliente cancela"><bpmn:incoming>F_ebg1_m_canc</bpmn:incoming><bpmn:outgoing>F_m_canc_e_canc</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_canc"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_canc" name="Cita cancelada"><bpmn:incoming>F_m_canc_e_canc</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_cita"><bpmn:incoming>F_m_conf_j_cita</bpmn:incoming><bpmn:incoming>F_t_hoy_j_cita</bpmn:incoming><bpmn:outgoing>F_j_cita_g_asis</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_asis" name="¿El cliente asistió?"><bpmn:incoming>F_j_cita_g_asis</bpmn:incoming><bpmn:outgoing>F_g_asis_e_inas</bpmn:outgoing><bpmn:outgoing>F_g_asis_t_recib</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_inas" name="Inasistencia (no se registra)"><bpmn:incoming>F_g_asis_e_inas</bpmn:incoming></bpmn:endEvent>
    <bpmn:manualTask id="t_recib" name="Recibir al cliente y verificar la cita"><bpmn:incoming>F_g_asis_t_recib</bpmn:incoming><bpmn:outgoing>F_t_recib_g_pago1</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g_pago1" name="¿Paga la consulta al inicio?"><bpmn:incoming>F_t_recib_g_pago1</bpmn:incoming><bpmn:outgoing>F_g_pago1_t_cobro1</bpmn:outgoing><bpmn:outgoing>F_g_pago1_j_p1</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="t_cobro1" name="Cobrar consulta y anotar en cuaderno de caja"><bpmn:incoming>F_g_pago1_t_cobro1</bpmn:incoming><bpmn:outgoing>F_t_cobro1_j_p1</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="j_p1"><bpmn:incoming>F_g_pago1_j_p1</bpmn:incoming><bpmn:incoming>F_t_cobro1_j_p1</bpmn:incoming><bpmn:outgoing>F_j_p1_t_escu</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_escu" name="Escuchar el caso y revisar documentos del cliente"><bpmn:incoming>F_j_p1_t_escu</bpmn:incoming><bpmn:outgoing>F_t_escu_t_conf</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="t_conf" name="Revisar conflicto de interés (contraparte vs. Excel)"><bpmn:incoming>F_t_escu_t_conf</bpmn:incoming><bpmn:outgoing>F_t_conf_g_conf</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_conf" name="¿Existe conflicto de interés?"><bpmn:incoming>F_t_conf_g_conf</bpmn:incoming><bpmn:outgoing>F_g_conf_g_enc</bpmn:outgoing><bpmn:outgoing>F_g_conf_t_nopat</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_enc" name="¿Tipo de encargo?"><bpmn:incoming>F_g_conf_g_enc</bpmn:incoming><bpmn:outgoing>F_g_enc_t_prop</bpmn:outgoing><bpmn:outgoing>F_g_enc_t_abs</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_prop" name="Explicar estrategia y proponer honorarios"><bpmn:incoming>F_g_enc_t_prop</bpmn:incoming><bpmn:outgoing>F_t_prop_j_res</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_abs" name="Absolver la consulta y orientar al cliente"><bpmn:incoming>F_g_enc_t_abs</bpmn:incoming><bpmn:outgoing>F_t_abs_j_res</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_nopat" name="Informar que no puede patrocinar el caso"><bpmn:incoming>F_g_conf_t_nopat</bpmn:incoming><bpmn:outgoing>F_t_nopat_j_res</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_res"><bpmn:incoming>F_t_prop_j_res</bpmn:incoming><bpmn:incoming>F_t_abs_j_res</bpmn:incoming><bpmn:incoming>F_t_nopat_j_res</bpmn:incoming><bpmn:outgoing>F_j_res_g_pagado</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_pagado" name="¿La consulta ya fue pagada?"><bpmn:incoming>F_j_res_g_pagado</bpmn:incoming><bpmn:outgoing>F_g_pagado_t_cobro2</bpmn:outgoing><bpmn:outgoing>F_g_pagado_j_p2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="t_cobro2" name="Cobrar consulta y anotar en cuaderno de caja"><bpmn:incoming>F_g_pagado_t_cobro2</bpmn:incoming><bpmn:outgoing>F_t_cobro2_j_p2</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="j_p2"><bpmn:incoming>F_g_pagado_j_p2</bpmn:incoming><bpmn:incoming>F_t_cobro2_j_p2</bpmn:incoming><bpmn:outgoing>F_j_p2_g_pat</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_pat" name="¿Se propuso patrocinio?"><bpmn:incoming>F_j_p2_g_pat</bpmn:incoming><bpmn:outgoing>F_g_pat_e_fin1</bpmn:outgoing><bpmn:outgoing>F_g_pat_par</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_fin1" name="Consulta concluida"><bpmn:incoming>F_g_pat_e_fin1</bpmn:incoming></bpmn:endEvent>
    <bpmn:parallelGateway id="par"><bpmn:incoming>F_g_pat_par</bpmn:incoming><bpmn:outgoing>F_par_t_explic</bpmn:outgoing><bpmn:outgoing>F_par_j_e</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="j_e"><bpmn:incoming>F_par_j_e</bpmn:incoming><bpmn:incoming>F_g_seg_j_e</bpmn:incoming><bpmn:incoming>F_t_ajus_j_e</bpmn:incoming><bpmn:outgoing>F_j_e_ebg2</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_explic" name="Explicar el caso al practicante"><bpmn:incoming>F_par_t_explic</bpmn:incoming><bpmn:outgoing>F_t_explic_t_grab</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_grab" name="Grabar audio de la explicación"><bpmn:incoming>F_t_explic_t_grab</bpmn:incoming><bpmn:outgoing>F_t_grab_t_trans</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="t_trans" name="Transcribir el audio con Gemini"><bpmn:incoming>F_t_grab_t_trans</bpmn:incoming><bpmn:outgoing>F_t_trans_t_drive</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_drive" name="Subir transcripción a Google Drive"><bpmn:incoming>F_t_trans_t_drive</bpmn:incoming><bpmn:outgoing>F_t_drive_e_doc</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="e_doc" name="Caso documentado"><bpmn:incoming>F_t_drive_e_doc</bpmn:incoming></bpmn:endEvent>
    <bpmn:eventBasedGateway id="ebg2"><bpmn:incoming>F_j_e_ebg2</bpmn:incoming><bpmn:outgoing>F_ebg2_m_acep</bpmn:outgoing><bpmn:outgoing>F_ebg2_m_ajus</bpmn:outgoing><bpmn:outgoing>F_ebg2_m_rech</bpmn:outgoing><bpmn:outgoing>F_ebg2_tm_5</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_acep" name="Cliente acepta"><bpmn:incoming>F_ebg2_m_acep</bpmn:incoming><bpmn:outgoing>F_m_acep_t_pagoad</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_acep"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_ajus" name="Cliente pide ajustar honorarios"><bpmn:incoming>F_ebg2_m_ajus</bpmn:incoming><bpmn:outgoing>F_m_ajus_t_ajus</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_ajus"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_rech" name="Cliente no acepta"><bpmn:incoming>F_ebg2_m_rech</bpmn:incoming><bpmn:outgoing>F_m_rech_e_rech</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_rech"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_rech" name="Propuesta rechazada"><bpmn:incoming>F_m_rech_e_rech</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm_5" name="5 días sin respuesta"><bpmn:incoming>F_ebg2_tm_5</bpmn:incoming><bpmn:outgoing>F_tm_5_t_seg</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_5"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_seg" name="Hacer seguimiento por WhatsApp"><bpmn:incoming>F_tm_5_t_seg</bpmn:incoming><bpmn:outgoing>F_t_seg_g_seg</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_seg" name="¿Menos de 3 seguimientos?"><bpmn:incoming>F_t_seg_g_seg</bpmn:incoming><bpmn:outgoing>F_g_seg_t_arch</bpmn:outgoing><bpmn:outgoing>F_g_seg_j_e</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_arch" name="Archivar prospecto"><bpmn:incoming>F_g_seg_t_arch</bpmn:incoming><bpmn:outgoing>F_t_arch_e_arch</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="e_arch" name="Prospecto archivado"><bpmn:incoming>F_t_arch_e_arch</bpmn:incoming></bpmn:endEvent>
    <bpmn:sendTask id="t_ajus" name="Ajustar honorarios (cuotas o descuento)"><bpmn:incoming>F_m_ajus_t_ajus</bpmn:incoming><bpmn:outgoing>F_t_ajus_j_e</bpmn:outgoing></bpmn:sendTask>
