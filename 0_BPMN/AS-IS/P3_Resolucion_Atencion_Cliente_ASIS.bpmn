<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_P3" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_P3_0"><bpmn:categoryValue id="CV_P3_0" value="FASE 1 · Análisis y comunicación del resultado"/></bpmn:category>
  <bpmn:category id="Cat_P3_1"><bpmn:categoryValue id="CV_P3_1" value="FASE 2 · Impugnación y ejecución"/></bpmn:category>
  <bpmn:category id="Cat_P3_2"><bpmn:categoryValue id="CV_P3_2" value="FASE 3 · Liquidación y cobro de honorarios"/></bpmn:category>
  <bpmn:category id="Cat_P3_3"><bpmn:categoryValue id="CV_P3_3" value="FASE 4 · Cierre y post-servicio"/></bpmn:category>
  <bpmn:process id="Proc_P3" name="P3 - Resolución del Caso y Atención al Cliente (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LS_P3">
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>t_agd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comliq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_bol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rconf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fac2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_env</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_regp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_pg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cfd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_est</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_agr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_nec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PRA" name="Practicante">
        <bpmn:flowNodeRef>t_sep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ABO" name="Abogado especialista">
        <bpmn:flowNodeRef>st_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>st_acu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>st_tra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>st_des</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ana</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_com</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_noap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_ap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hon2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ac2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_apel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_2da</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_apc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_absl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_firme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ejec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_ejec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_ej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_liq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_liq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deuda</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="st_res" name="Resolución final notificada"><bpmn:outgoing>F_st_res_t_ana</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_res"/></bpmn:startEvent>
    <bpmn:startEvent id="st_acu" name="Acuerdo conciliatorio (viene de P2)"><bpmn:outgoing>F_st_acu_j_firme</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_acu"/></bpmn:startEvent>
    <bpmn:startEvent id="st_tra" name="Trámite concluido (viene de P2)"><bpmn:outgoing>F_st_tra_j_firme</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_tra"/></bpmn:startEvent>
    <bpmn:startEvent id="st_des" name="Desistimiento del cliente (viene de P2)"><bpmn:outgoing>F_st_des_j_liq</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_des"/></bpmn:startEvent>
    <bpmn:manualTask id="t_ana" name="Analizar la resolución final"><bpmn:incoming>F_st_res_t_ana</bpmn:incoming><bpmn:outgoing>F_t_ana_t_agd</bpmn:outgoing></bpmn:manualTask>
    <bpmn:sendTask id="t_agd" name="Agendar reunión o llamada con el cliente"><bpmn:incoming>F_t_ana_t_agd</bpmn:incoming><bpmn:outgoing>F_t_agd_t_com</bpmn:outgoing></bpmn:sendTask>
    <bpmn:sendTask id="t_com" name="Comunicar el resultado al cliente"><bpmn:incoming>F_t_agd_t_com</bpmn:incoming><bpmn:outgoing>F_t_com_g_res</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_res" name="¿Resultado para el cliente?"><bpmn:incoming>F_t_com_g_res</bpmn:incoming><bpmn:outgoing>F_g_res_ebg_d</bpmn:outgoing><bpmn:outgoing>F_g_res_ebg_f</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_d"><bpmn:incoming>F_g_res_ebg_d</bpmn:incoming><bpmn:outgoing>F_ebg_d_m_ap</bpmn:outgoing><bpmn:outgoing>F_ebg_d_m_noap</bpmn:outgoing><bpmn:outgoing>F_ebg_d_tm_ap</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_ap" name="Cliente decide apelar"><bpmn:incoming>F_ebg_d_m_ap</bpmn:incoming><bpmn:outgoing>F_m_ap_t_hon2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_ap"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_noap" name="Cliente decide no apelar"><bpmn:incoming>F_ebg_d_m_noap</bpmn:incoming><bpmn:outgoing>F_m_noap_j_firme</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_noap"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_ap" name="Vence plazo de apelación"><bpmn:incoming>F_ebg_d_tm_ap</bpmn:incoming><bpmn:outgoing>F_tm_ap_j_firme</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_ap"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_hon2" name="Proponer honorarios de 2.ª instancia"><bpmn:incoming>F_m_ap_t_hon2</bpmn:incoming><bpmn:outgoing>F_t_hon2_g_ac2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_ac2" name="¿Acepta los honorarios?"><bpmn:incoming>F_t_hon2_g_ac2</bpmn:incoming><bpmn:outgoing>F_g_ac2_t_apel</bpmn:outgoing><bpmn:outgoing>F_g_ac2_j_firme</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_apel" name="Presentar recurso de apelación"><bpmn:incoming>F_g_ac2_t_apel</bpmn:incoming><bpmn:outgoing>F_t_apel_e_2da</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e_2da" name="Pasa a 2.ª instancia (vuelve a P2)"><bpmn:incoming>F_t_apel_e_2da</bpmn:incoming></bpmn:endEvent>
    <bpmn:eventBasedGateway id="ebg_f"><bpmn:incoming>F_g_res_ebg_f</bpmn:incoming><bpmn:outgoing>F_ebg_f_m_apc</bpmn:outgoing><bpmn:outgoing>F_ebg_f_tm_cons</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_apc" name="Contraparte apela (notificación)"><bpmn:incoming>F_ebg_f_m_apc</bpmn:incoming><bpmn:outgoing>F_m_apc_e_absl</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_apc"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_absl" name="Absolver la apelación (vuelve a P2)"><bpmn:incoming>F_m_apc_e_absl</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm_cons" name="Vence plazo sin apelación"><bpmn:incoming>F_ebg_f_tm_cons</bpmn:incoming><bpmn:outgoing>F_tm_cons_j_firme</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_cons"/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="j_firme" name="Sentencia firme"><bpmn:incoming>F_g_ac2_j_firme</bpmn:incoming><bpmn:incoming>F_m_noap_j_firme</bpmn:incoming><bpmn:incoming>F_tm_ap_j_firme</bpmn:incoming><bpmn:incoming>F_tm_cons_j_firme</bpmn:incoming><bpmn:incoming>F_st_acu_j_firme</bpmn:incoming><bpmn:incoming>F_st_tra_j_firme</bpmn:incoming><bpmn:outgoing>F_j_firme_g_ejec</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_ejec" name="¿Requiere ejecución?"><bpmn:incoming>F_j_firme_g_ejec</bpmn:incoming><bpmn:outgoing>F_g_ejec_sp_ejec</bpmn:outgoing><bpmn:outgoing>F_g_ejec_j_ej</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_ejec" name="Ejecutar la sentencia"><bpmn:incoming>F_g_ejec_sp_ejec</bpmn:incoming><bpmn:outgoing>F_sp_ejec_j_ej</bpmn:outgoing><bpmn:startEvent id="x_st" name="Inicio"><bpmn:outgoing>F_x_st_x_t1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="x_t1" name="Solicitar la ejecución de la sentencia"><bpmn:incoming>F_x_st_x_t1</bpmn:incoming><bpmn:outgoing>F_x_t1_x_m1</bpmn:outgoing></bpmn:sendTask><bpmn:intermediateCatchEvent id="x_m1" name="Mandato de ejecución notificado"><bpmn:incoming>F_x_t1_x_m1</bpmn:incoming><bpmn:outgoing>F_x_m1_x_t2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_x_m1"/></bpmn:intermediateCatchEvent><bpmn:sendTask id="x_t2" name="Informar al cliente"><bpmn:incoming>F_x_m1_x_t2</bpmn:incoming><bpmn:outgoing>F_x_t2_x_j</bpmn:outgoing></bpmn:sendTask><bpmn:exclusiveGateway id="x_j"><bpmn:incoming>F_x_t2_x_j</bpmn:incoming><bpmn:incoming>F_x_t4_x_j</bpmn:incoming><bpmn:outgoing>F_x_j_x_tm</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:intermediateCatchEvent id="x_tm" name="Vence plazo de cumplimiento"><bpmn:incoming>F_x_j_x_tm</bpmn:incoming><bpmn:outgoing>F_x_tm_x_g</bpmn:outgoing><bpmn:timerEventDefinition id="ED_x_tm"/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="x_g" name="¿El obligado cumplió?"><bpmn:incoming>F_x_tm_x_g</bpmn:incoming><bpmn:outgoing>F_x_g_x_t3</bpmn:outgoing><bpmn:outgoing>F_x_g_x_t4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="x_t3" name="Registrar cobro o inscripción"><bpmn:incoming>F_x_g_x_t3</bpmn:incoming><bpmn:outgoing>F_x_t3_x_e</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="x_e" name="Sentencia ejecutada"><bpmn:incoming>F_x_t3_x_e</bpmn:incoming></bpmn:endEvent><bpmn:sendTask id="x_t4" name="Solicitar embargo o medida forzosa"><bpmn:incoming>F_x_g_x_t4</bpmn:incoming><bpmn:outgoing>F_x_t4_x_j</bpmn:outgoing></bpmn:sendTask><bpmn:sequenceFlow id="F_x_st_x_t1" sourceRef="x_st" targetRef="x_t1"/><bpmn:sequenceFlow id="F_x_t1_x_m1" sourceRef="x_t1" targetRef="x_m1"/><bpmn:sequenceFlow id="F_x_m1_x_t2" sourceRef="x_m1" targetRef="x_t2"/><bpmn:sequenceFlow id="F_x_t2_x_j" sourceRef="x_t2" targetRef="x_j"/><bpmn:sequenceFlow id="F_x_j_x_tm" sourceRef="x_j" targetRef="x_tm"/><bpmn:sequenceFlow id="F_x_tm_x_g" sourceRef="x_tm" targetRef="x_g"/><bpmn:sequenceFlow id="F_x_g_x_t3" name="Sí" sourceRef="x_g" targetRef="x_t3"/><bpmn:sequenceFlow id="F_x_t3_x_e" sourceRef="x_t3" targetRef="x_e"/><bpmn:sequenceFlow id="F_x_g_x_t4" name="No" sourceRef="x_g" targetRef="x_t4"/><bpmn:sequenceFlow id="F_x_t4_x_j" sourceRef="x_t4" targetRef="x_j"/></bpmn:subProcess>
    <bpmn:exclusiveGateway id="j_ej"><bpmn:incoming>F_sp_ejec_j_ej</bpmn:incoming><bpmn:incoming>F_g_ejec_j_ej</bpmn:incoming><bpmn:outgoing>F_j_ej_j_liq</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="j_liq"><bpmn:incoming>F_j_ej_j_liq</bpmn:incoming><bpmn:incoming>F_st_des_j_liq</bpmn:incoming><bpmn:outgoing>F_j_liq_t_rev</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_rev" name="Revisar monto pactado, abonos y saldo"><bpmn:incoming>F_j_liq_t_rev</bpmn:incoming><bpmn:outgoing>F_t_rev_g_cl</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_cl" name="¿Hay cuota litis y resultado favorable?"><bpmn:incoming>F_t_rev_g_cl</bpmn:incoming><bpmn:outgoing>F_g_cl_t_cl</bpmn:outgoing><bpmn:outgoing>F_g_cl_j_cl</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_cl" name="Calcular cuota litis sobre lo obtenido"><bpmn:incoming>F_g_cl_t_cl</bpmn:incoming><bpmn:outgoing>F_t_cl_j_cl</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_cl"><bpmn:incoming>F_t_cl_j_cl</bpmn:incoming><bpmn:incoming>F_g_cl_j_cl</bpmn:incoming><bpmn:outgoing>F_j_cl_t_liq</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_liq" name="Elaborar la liquidación final"><bpmn:incoming>F_j_cl_t_liq</bpmn:incoming><bpmn:outgoing>F_t_liq_t_comliq</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_comliq" name="Comunicar la liquidación al cliente"><bpmn:incoming>F_t_liq_t_comliq</bpmn:incoming><bpmn:outgoing>F_t_comliq_g_tipo</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_tipo" name="¿Tipo de cliente?"><bpmn:incoming>F_t_comliq_g_tipo</bpmn:incoming><bpmn:outgoing>F_g_tipo_t_bol</bpmn:outgoing><bpmn:outgoing>F_g_tipo_t_fac</bpmn:outgoing><bpmn:outgoing>F_g_tipo_t_conf</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_bol" name="Emitir boleta (SUNAT SOL)"><bpmn:incoming>F_g_tipo_t_bol</bpmn:incoming><bpmn:outgoing>F_t_bol_j_tipo</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_fac" name="Emitir factura (SUNAT SOL)"><bpmn:incoming>F_g_tipo_t_fac</bpmn:incoming><bpmn:outgoing>F_t_fac_j_tipo</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_conf" name="Solicitar conformidad del servicio"><bpmn:incoming>F_g_tipo_t_conf</bpmn:incoming><bpmn:outgoing>F_t_conf_t_rconf</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="t_rconf" name="Recibir conformidad del servicio"><bpmn:incoming>F_t_conf_t_rconf</bpmn:incoming><bpmn:outgoing>F_t_rconf_t_fac2</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:userTask id="t_fac2" name="Emitir factura (SUNAT SOL)"><bpmn:incoming>F_t_rconf_t_fac2</bpmn:incoming><bpmn:outgoing>F_t_fac2_j_tipo</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_tipo"><bpmn:incoming>F_t_bol_j_tipo</bpmn:incoming><bpmn:incoming>F_t_fac_j_tipo</bpmn:incoming><bpmn:incoming>F_t_fac2_j_tipo</bpmn:incoming><bpmn:outgoing>F_j_tipo_t_env</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_env" name="Enviar comprobante y datos de pago"><bpmn:incoming>F_j_tipo_t_env</bpmn:incoming><bpmn:outgoing>F_t_env_j_c</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_c"><bpmn:incoming>F_t_env_j_c</bpmn:incoming><bpmn:incoming>F_g_rec_j_c</bpmn:incoming><bpmn:outgoing>F_j_c_ebg_p</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_p"><bpmn:incoming>F_j_c_ebg_p</bpmn:incoming><bpmn:outgoing>F_ebg_p_m_pago</bpmn:outgoing><bpmn:outgoing>F_ebg_p_tm_15</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_pago" name="Pago recibido"><bpmn:incoming>F_ebg_p_m_pago</bpmn:incoming><bpmn:outgoing>F_m_pago_t_regp</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_pago"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_regp" name="Registrar pago en Excel y entregar comprobante"><bpmn:incoming>F_m_pago_t_regp</bpmn:incoming><bpmn:outgoing>F_t_regp_j_pg</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="tm_15" name="15 días sin pago"><bpmn:incoming>F_ebg_p_tm_15</bpmn:incoming><bpmn:outgoing>F_tm_15_t_rp</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_15"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_rp" name="Enviar recordatorio de pago"><bpmn:incoming>F_tm_15_t_rp</bpmn:incoming><bpmn:outgoing>F_t_rp_g_rec</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_rec" name="¿Menos de 3 recordatorios?"><bpmn:incoming>F_t_rp_g_rec</bpmn:incoming><bpmn:outgoing>F_g_rec_j_c</bpmn:outgoing><bpmn:outgoing>F_g_rec_t_deuda</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_deuda" name="Decidir: fraccionar o registrar deuda pendiente"><bpmn:incoming>F_g_rec_t_deuda</bpmn:incoming><bpmn:outgoing>F_t_deuda_j_pg</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_pg"><bpmn:incoming>F_t_regp_j_pg</bpmn:incoming><bpmn:incoming>F_t_deuda_j_pg</bpmn:incoming><bpmn:outgoing>F_j_pg_t_sep</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_sep" name="Separar originales y preparar cargo de devolución"><bpmn:incoming>F_j_pg_t_sep</bpmn:incoming><bpmn:outgoing>F_t_sep_t_cfd</bpmn:outgoing></bpmn:manualTask>
    <bpmn:sendTask id="t_cfd" name="Coordinar fecha de devolución con el cliente"><bpmn:incoming>F_t_sep_t_cfd</bpmn:incoming><bpmn:outgoing>F_t_cfd_t_dev</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_dev" name="Entregar documentos y recabar firma del cargo"><bpmn:incoming>F_t_cfd_t_dev</bpmn:incoming><bpmn:outgoing>F_t_dev_t_arch</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_arch" name="Archivar expediente físico y mover carpeta Drive a Cerrados"><bpmn:incoming>F_t_dev_t_arch</bpmn:incoming><bpmn:outgoing>F_t_arch_t_est</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="t_est" name="Actualizar estado del caso a Cerrado en Excel"><bpmn:incoming>F_t_arch_t_est</bpmn:incoming><bpmn:outgoing>F_t_est_t_agr</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_agr" name="Agradecer y pedir recomendación por WhatsApp"><bpmn:incoming>F_t_est_t_agr</bpmn:incoming><bpmn:outgoing>F_t_agr_g_nec</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_nec" name="¿El cliente tiene una nueva necesidad?"><bpmn:incoming>F_t_agr_g_nec</bpmn:incoming><bpmn:outgoing>F_g_nec_e_fin</bpmn:outgoing><bpmn:outgoing>F_g_nec_e_nue</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_fin" name="Servicio concluido"><bpmn:incoming>F_g_nec_e_fin</bpmn:incoming></bpmn:endEvent>
