    <bpmn:textAnnotation id="n1"><bpmn:text>El plazo de apelación depende del tipo de proceso y se controla a mano en la agenda.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n1" sourceRef="ebg_d" targetRef="n1"/>
    <bpmn:textAnnotation id="n2"><bpmn:text>Si el obligado es el Estado, el pago depende de su presupuesto (más lento).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n2" sourceRef="sp_ejec" targetRef="n2"/>
    <bpmn:textAnnotation id="n3"><bpmn:text>Cliente recurrente con iguala mensual: se factura por mes, no por caso.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n3" sourceRef="g_tipo" targetRef="n3"/>
    <bpmn:textAnnotation id="n4"><bpmn:text>Factura con detracción si corresponde.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n4" sourceRef="t_fac" targetRef="n4"/>
    <bpmn:textAnnotation id="n5"><bpmn:text>En el AS-IS no existe una encuesta formal de satisfacción.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n5" sourceRef="t_agr" targetRef="n5"/>
    <bpmn:textAnnotation id="n6"><bpmn:text>Pactada en el contrato de servicios (P1).</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n6" sourceRef="t_cl" targetRef="n6"/>
