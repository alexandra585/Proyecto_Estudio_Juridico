        <bpmn:flowNodeRef>t_cargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_etapa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_sem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_nov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_bajar</bpmn:flowNodeRef>
      </bpmn:lane>
