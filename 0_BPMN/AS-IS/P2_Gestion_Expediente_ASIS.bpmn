    <bpmn:startEvent id="st" name="Caso aperturado (viene de P1)"><bpmn:outgoing>F_st_t_rev</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_rev" name="Revisar transcripción y documentos en Drive"><bpmn:incoming>F_st_t_rev</bpmn:incoming><bpmn:outgoing>F_t_rev_j_doc</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_doc"><bpmn:incoming>F_t_rev_j_doc</bpmn:incoming><bpmn:incoming>F_t_dig_j_doc</bpmn:incoming><bpmn:outgoing>F_j_doc_g_doc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_doc" name="¿Documentación completa?"><bpmn:incoming>F_j_doc_g_doc</bpmn:incoming><bpmn:outgoing>F_g_doc_t_sol</bpmn:outgoing><bpmn:outgoing>F_g_doc_t_est</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_sol" name="Solicitar documentos faltantes por WhatsApp"><bpmn:incoming>F_g_doc_t_sol</bpmn:incoming><bpmn:outgoing>F_t_sol_j_d</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_d"><bpmn:incoming>F_t_sol_j_d</bpmn:incoming><bpmn:incoming>F_t_rec_j_d</bpmn:incoming><bpmn:outgoing>F_j_d_ebg_d</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_d"><bpmn:incoming>F_j_d_ebg_d</bpmn:incoming><bpmn:outgoing>F_ebg_d_m_docs</bpmn:outgoing><bpmn:outgoing>F_ebg_d_tm_3</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_docs" name="Documentos recibidos"><bpmn:incoming>F_ebg_d_m_docs</bpmn:incoming><bpmn:outgoing>F_m_docs_t_dig</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_docs"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_3" name="3 días sin respuesta"><bpmn:incoming>F_ebg_d_tm_3</bpmn:incoming><bpmn:outgoing>F_tm_3_t_rec</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_3"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_rec" name="Recordar al cliente"><bpmn:incoming>F_tm_3_t_rec</bpmn:incoming><bpmn:outgoing>F_t_rec_j_d</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_dig" name="Digitalizar documentos y subirlos a Drive"><bpmn:incoming>F_m_docs_t_dig</bpmn:incoming><bpmn:outgoing>F_t_dig_j_doc</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_est" name="Estudiar el caso y definir la estrategia"><bpmn:incoming>F_g_doc_t_est</bpmn:incoming><bpmn:outgoing>F_t_est_t_plz</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_plz" name="Anotar plazos críticos en la agenda"><bpmn:incoming>F_t_est_t_plz</bpmn:incoming><bpmn:outgoing>F_t_plz_g_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g_rol" name="¿Rol del cliente en el caso?"><bpmn:incoming>F_t_plz_g_rol</bpmn:incoming><bpmn:outgoing>F_g_rol_g_conc</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_notif</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_den</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_cop</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_vio</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_adm</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_ca</bpmn:outgoing><bpmn:outgoing>F_g_rol_t_tra</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_conc" name="¿Exige conciliación previa?"><bpmn:incoming>F_g_rol_g_conc</bpmn:incoming><bpmn:outgoing>F_g_conc_sp_conc</bpmn:outgoing><bpmn:outgoing>F_g_conc_j_a</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_conc" name="Conciliación extrajudicial"><bpmn:incoming>F_g_conc_sp_conc</bpmn:incoming><bpmn:outgoing>F_sp_conc_g_acu</bpmn:outgoing><bpmn:startEvent id="c_st" name="Inicio"><bpmn:outgoing>F_c_st_c_t1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="c_t1" name="Presentar solicitud en el centro de conciliación"><bpmn:incoming>F_c_st_c_t1</bpmn:incoming><bpmn:outgoing>F_c_t1_c_t2</bpmn:outgoing></bpmn:sendTask><bpmn:manualTask id="c_t2" name="Pagar la tarifa del centro"><bpmn:incoming>F_c_t1_c_t2</bpmn:incoming><bpmn:outgoing>F_c_t2_c_m1</bpmn:outgoing></bpmn:manualTask><bpmn:intermediateCatchEvent id="c_m1" name="Invitación a audiencia recibida"><bpmn:incoming>F_c_t2_c_m1</bpmn:incoming><bpmn:outgoing>F_c_m1_c_t3</bpmn:outgoing><bpmn:messageEventDefinition id="ED_c_m1"/></bpmn:intermediateCatchEvent><bpmn:sendTask id="c_t3" name="Avisar al cliente la fecha"><bpmn:incoming>F_c_m1_c_t3</bpmn:incoming><bpmn:outgoing>F_c_t3_c_t4</bpmn:outgoing></bpmn:sendTask><bpmn:manualTask id="c_t4" name="Asistir a la audiencia con el cliente"><bpmn:incoming>F_c_t3_c_t4</bpmn:incoming><bpmn:outgoing>F_c_t4_c_g</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="c_g" name="¿Hubo acuerdo?"><bpmn:incoming>F_c_t4_c_g</bpmn:incoming><bpmn:outgoing>F_c_g_c_t5</bpmn:outgoing><bpmn:outgoing>F_c_g_c_t6</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:manualTask id="c_t5" name="Firmar acta con acuerdo"><bpmn:incoming>F_c_g_c_t5</bpmn:incoming><bpmn:outgoing>F_c_t5_c_e1</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="c_e1" name="Acta con acuerdo"><bpmn:incoming>F_c_t5_c_e1</bpmn:incoming></bpmn:endEvent><bpmn:manualTask id="c_t6" name="Recibir acta de falta de acuerdo"><bpmn:incoming>F_c_g_c_t6</bpmn:incoming><bpmn:outgoing>F_c_t6_c_e2</bpmn:outgoing></bpmn:manualTask><bpmn:endEvent id="c_e2" name="Acta sin acuerdo"><bpmn:incoming>F_c_t6_c_e2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_c_st_c_t1" sourceRef="c_st" targetRef="c_t1"/><bpmn:sequenceFlow id="F_c_t1_c_t2" sourceRef="c_t1" targetRef="c_t2"/><bpmn:sequenceFlow id="F_c_t2_c_m1" sourceRef="c_t2" targetRef="c_m1"/><bpmn:sequenceFlow id="F_c_m1_c_t3" sourceRef="c_m1" targetRef="c_t3"/><bpmn:sequenceFlow id="F_c_t3_c_t4" sourceRef="c_t3" targetRef="c_t4"/><bpmn:sequenceFlow id="F_c_t4_c_g" sourceRef="c_t4" targetRef="c_g"/><bpmn:sequenceFlow id="F_c_g_c_t5" name="Sí" sourceRef="c_g" targetRef="c_t5"/><bpmn:sequenceFlow id="F_c_t5_c_e1" sourceRef="c_t5" targetRef="c_e1"/><bpmn:sequenceFlow id="F_c_g_c_t6" name="No" sourceRef="c_g" targetRef="c_t6"/><bpmn:sequenceFlow id="F_c_t6_c_e2" sourceRef="c_t6" targetRef="c_e2"/></bpmn:subProcess>
    <bpmn:exclusiveGateway id="g_acu" name="¿Hubo acuerdo?"><bpmn:incoming>F_sp_conc_g_acu</bpmn:incoming><bpmn:outgoing>F_g_acu_e_acu</bpmn:outgoing><bpmn:outgoing>F_g_acu_j_a</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_acu" name="Acuerdo conciliatorio (pasa a P3)"><bpmn:incoming>F_g_acu_e_acu</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_a"><bpmn:incoming>F_g_acu_j_a</bpmn:incoming><bpmn:incoming>F_g_conc_j_a</bpmn:incoming><bpmn:outgoing>F_j_a_t_dem</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_dem" name="Redactar demanda"><bpmn:incoming>F_j_a_t_dem</bpmn:incoming><bpmn:outgoing>F_t_dem_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="t_notif" name="Registrar fecha de notificación y plazo para contestar"><bpmn:incoming>F_g_rol_t_notif</bpmn:incoming><bpmn:outgoing>F_t_notif_t_cont</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="t_cont" name="Redactar contestación de demanda"><bpmn:incoming>F_t_notif_t_cont</bpmn:incoming><bpmn:outgoing>F_t_cont_g_reco</bpmn:outgoing></bpmn:manualTask>
    <bpmn:boundaryEvent id="b_cont" name="Vence plazo para contestar" attachedToRef="t_cont"><bpmn:outgoing>F_b_cont_e_reb</bpmn:outgoing><bpmn:timerEventDefinition id="ED_b_cont"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="e_reb" name="Cliente declarado rebelde"><bpmn:incoming>F_b_cont_e_reb</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="g_reco" name="¿Reconviene o deduce excepciones?"><bpmn:incoming>F_t_cont_g_reco</bpmn:incoming><bpmn:outgoing>F_g_reco_t_reco</bpmn:outgoing><bpmn:outgoing>F_g_reco_j_p</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_reco" name="Agregar reconvención o excepciones"><bpmn:incoming>F_g_reco_t_reco</bpmn:incoming><bpmn:outgoing>F_t_reco_j_p</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_p"><bpmn:incoming>F_g_reco_j_p</bpmn:incoming><bpmn:incoming>F_t_reco_j_p</bpmn:incoming><bpmn:outgoing>F_j_p_j_rol</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_den" name="Redactar denuncia o constitución en actor civil"><bpmn:incoming>F_g_rol_t_den</bpmn:incoming><bpmn:outgoing>F_t_den_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_cop" name="Solicitar copias de la carpeta fiscal"><bpmn:incoming>F_g_rol_t_cop</bpmn:incoming><bpmn:outgoing>F_t_cop_g_det</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g_det" name="¿El cliente está detenido?"><bpmn:incoming>F_t_cop_g_det</bpmn:incoming><bpmn:outgoing>F_g_det_t_urg</bpmn:outgoing><bpmn:outgoing>F_g_det_t_desc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_urg" name="Preparar defensa urgente (prisión preventiva)"><bpmn:incoming>F_g_det_t_urg</bpmn:incoming><bpmn:outgoing>F_t_urg_j_pe</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_desc" name="Redactar descargos"><bpmn:incoming>F_g_det_t_desc</bpmn:incoming><bpmn:outgoing>F_t_desc_j_pe</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_pe"><bpmn:incoming>F_t_urg_j_pe</bpmn:incoming><bpmn:incoming>F_t_desc_j_pe</bpmn:incoming><bpmn:outgoing>F_j_pe_j_rol</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_vio" name="Solicitar o contestar medidas de protección"><bpmn:incoming>F_g_rol_t_vio</bpmn:incoming><bpmn:outgoing>F_t_vio_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_adm" name="Redactar recurso o descargos administrativos"><bpmn:incoming>F_g_rol_t_adm</bpmn:incoming><bpmn:outgoing>F_t_adm_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_ca" name="Redactar solicitud de conciliación o demanda arbitral"><bpmn:incoming>F_g_rol_t_ca</bpmn:incoming><bpmn:outgoing>F_t_ca_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="t_tra" name="Reunir requisitos y preparar solicitud del trámite"><bpmn:incoming>F_g_rol_t_tra</bpmn:incoming><bpmn:outgoing>F_t_tra_j_rol</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_rol"><bpmn:incoming>F_t_dem_j_rol</bpmn:incoming><bpmn:incoming>F_j_p_j_rol</bpmn:incoming><bpmn:incoming>F_t_den_j_rol</bpmn:incoming><bpmn:incoming>F_j_pe_j_rol</bpmn:incoming><bpmn:incoming>F_t_vio_j_rol</bpmn:incoming><bpmn:incoming>F_t_adm_j_rol</bpmn:incoming><bpmn:incoming>F_t_ca_j_rol</bpmn:incoming><bpmn:incoming>F_t_tra_j_rol</bpmn:incoming><bpmn:outgoing>F_j_rol_g_cpx</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_cpx" name="¿Escrito de alta complejidad?"><bpmn:incoming>F_j_rol_g_cpx</bpmn:incoming><bpmn:outgoing>F_g_cpx_t_red</bpmn:outgoing><bpmn:outgoing>F_g_cpx_t_bor</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="t_red" name="Redactar el escrito"><bpmn:incoming>F_g_cpx_t_red</bpmn:incoming><bpmn:outgoing>F_t_red_j_red</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="t_bor" name="Redactar borrador con ChatGPT Plus"><bpmn:incoming>F_g_cpx_t_bor</bpmn:incoming><bpmn:outgoing>F_t_bor_j_red</bpmn:outgoing></bpmn:userTask>
