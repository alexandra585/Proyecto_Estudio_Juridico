<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_P2" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_P2_0"><bpmn:categoryValue id="CV_P2_0" value="FASE 1 · Preparación del caso y estrategia según el rol del cliente"/></bpmn:category>
  <bpmn:category id="Cat_P2_1"><bpmn:categoryValue id="CV_P2_1" value="FASE 2 · Elaboración y presentación del escrito"/></bpmn:category>
  <bpmn:category id="Cat_P2_2"><bpmn:categoryValue id="CV_P2_2" value="FASE 3 · Seguimiento del expediente"/></bpmn:category>
  <bpmn:category id="Cat_P2_3"><bpmn:categoryValue id="CV_P2_3" value="Subprocesos de evento (en cualquier momento)"/></bpmn:category>
  <bpmn:process id="Proc_P2" name="P2 - Gestión del Expediente (AS-IS)" isExecutable="false">
    <bpmn:laneSet id="LS_P2">
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>t_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_docs</bpmn:flowNodeRef>
