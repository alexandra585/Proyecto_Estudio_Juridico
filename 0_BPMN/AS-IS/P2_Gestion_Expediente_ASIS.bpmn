    <bpmn:textAnnotation id="n1"><bpmn:text>Los plazos solo se controlan en la agenda física: riesgo de vencimiento.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n1" sourceRef="t_plz" targetRef="n1"/>
    <bpmn:textAnnotation id="n2"><bpmn:text>Detalle de los 24 roles: catálogo en la base de datos. Aquí se agrupan por familia.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n2" sourceRef="g_rol" targetRef="n2"/>
    <bpmn:textAnnotation id="n3"><bpmn:text>Ante INDECOPI, SUNAFIL, SUNAT, municipalidad, etc.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n3" sourceRef="t_adm" targetRef="n3"/>
    <bpmn:textAnnotation id="n4"><bpmn:text>Atención inmediata: plazos de 24 a 72 horas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n4" sourceRef="t_vio" targetRef="n4"/>
    <bpmn:textAnnotation id="n5"><bpmn:text>Usa la transcripción de Gemini y jurisprudencia buscada manualmente.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n5" sourceRef="t_bor" targetRef="n5"/>
    <bpmn:textAnnotation id="n6"><bpmn:text>El practicante revisa cada expediente uno por uno.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n6" sourceRef="t_cej" targetRef="n6"/>
    <bpmn:textAnnotation id="n7"><bpmn:text>La paga el cliente o el estudio la adelanta.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n7" sourceRef="t_tasa" targetRef="n7"/>
