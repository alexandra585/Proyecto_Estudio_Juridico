<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_T2" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_T2_0"><bpmn:categoryValue id="CV_T2_0" value="FASE 1 · Preparación del caso y control de plazos"/></bpmn:category>
  <bpmn:category id="Cat_T2_1"><bpmn:categoryValue id="CV_T2_1" value="FASE 2 · Elaboración y presentación del escrito"/></bpmn:category>
  <bpmn:category id="Cat_T2_2"><bpmn:categoryValue id="CV_T2_2" value="FASE 3 · Seguimiento del expediente"/></bpmn:category>
  <bpmn:category id="Cat_T2_3"><bpmn:categoryValue id="CV_T2_3" value="Subprocesos de evento (en cualquier momento)"/></bpmn:category>
  <bpmn:process id="Proc_T2" name="P2 - Gestión del Expediente (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LS_T2">
      <bpmn:lane id="L_SIS" name="Sistema Magallanes-Montero">
        <bpmn:flowNodeRef>st</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_guar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_firm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rfir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_etapa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_sem</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>es5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PRA" name="Practicante">
        <bpmn:flowNodeRef>t_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_doc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_redP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tasa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tasa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tasa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_pres</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cargo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_nov</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_regr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ABO" name="Abogado especialista">
        <bpmn:flowNodeRef>t_est</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_plz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_conc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_acu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_acu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_redA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_red</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_fir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_fir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_modo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_mpe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_aud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_absl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_imp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recur</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_sinex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reqd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_esp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="st" name="Caso aperturado (viene de P1)"><bpmn:outgoing>F_st_t_chk</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_chk" name="Revisar expediente digital y checklist de documentos"><bpmn:incoming>F_st_t_chk</bpmn:incoming><bpmn:outgoing>F_t_chk_j_doc</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_doc"><bpmn:incoming>F_t_chk_j_doc</bpmn:incoming><bpmn:incoming>F_t_guar_j_doc</bpmn:incoming><bpmn:outgoing>F_j_doc_g_doc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_doc" name="¿Documentación completa?"><bpmn:incoming>F_j_doc_g_doc</bpmn:incoming><bpmn:outgoing>F_g_doc_t_sol</bpmn:outgoing><bpmn:outgoing>F_g_doc_t_est</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_sol" name="Solicitar documentos faltantes por el portal y WhatsApp"><bpmn:incoming>F_g_doc_t_sol</bpmn:incoming><bpmn:outgoing>F_t_sol_j_d</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_d"><bpmn:incoming>F_t_sol_j_d</bpmn:incoming><bpmn:incoming>F_t_recd_j_d</bpmn:incoming><bpmn:outgoing>F_j_d_ebg_d</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_d"><bpmn:incoming>F_j_d_ebg_d</bpmn:incoming><bpmn:outgoing>F_ebg_d_m_docs</bpmn:outgoing><bpmn:outgoing>F_ebg_d_tm_3</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_docs" name="Cliente sube documentos al portal"><bpmn:incoming>F_ebg_d_m_docs</bpmn:incoming><bpmn:outgoing>F_m_docs_t_guar</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_docs"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_3" name="3 días sin respuesta"><bpmn:incoming>F_ebg_d_tm_3</bpmn:incoming><bpmn:outgoing>F_tm_3_t_recd</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_3"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_recd" name="Enviar recordatorio automático"><bpmn:incoming>F_tm_3_t_recd</bpmn:incoming><bpmn:outgoing>F_t_recd_j_d</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="t_guar" name="Guardar documentos en el expediente digital"><bpmn:incoming>F_m_docs_t_guar</bpmn:incoming><bpmn:outgoing>F_t_guar_j_doc</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_est" name="Estudiar el caso y definir la estrategia"><bpmn:incoming>F_g_doc_t_est</bpmn:incoming><bpmn:outgoing>F_t_est_t_plz</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_plz" name="Registrar plazos críticos en el sistema"><bpmn:incoming>F_t_est_t_plz</bpmn:incoming><bpmn:outgoing>F_t_plz_t_alr</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_alr" name="Programar alertas de vencimiento"><bpmn:incoming>F_t_plz_t_alr</bpmn:incoming><bpmn:outgoing>F_t_alr_g_conc</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_conc" name="¿Exige conciliación previa?"><bpmn:incoming>F_t_alr_g_conc</bpmn:incoming><bpmn:outgoing>F_g_conc_sp_conc</bpmn:outgoing><bpmn:outgoing>F_g_conc_j_c</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_conc" name="Conciliación extrajudicial"><bpmn:incoming>F_g_conc_sp_conc</bpmn:incoming><bpmn:outgoing>F_sp_conc_g_acu</bpmn:outgoing><bpmn:startEvent id="c_st" name="Inicio"><bpmn:outgoing>F_c_st_c_t1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="c_t1" name="Presentar solicitud al centro de conciliación"><bpmn:incoming>F_c_st_c_t1</bpmn:incoming><bpmn:outgoing>F_c_t1_c_m1</bpmn:outgoing></bpmn:sendTask><bpmn:intermediateCatchEvent id="c_m1" name="Invitación a audiencia recibida"><bpmn:incoming>F_c_t1_c_m1</bpmn:incoming><bpmn:outgoing>F_c_m1_c_t2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_c_m1"/></bpmn:intermediateCatchEvent><bpmn:serviceTask id="c_t2" name="Registrar audiencia y notificar al cliente"><bpmn:incoming>F_c_m1_c_t2</bpmn:incoming><bpmn:outgoing>F_c_t2_c_t3</bpmn:outgoing></bpmn:serviceTask><bpmn:manualTask id="c_t3" name="Asistir a la audiencia con el cliente"><bpmn:incoming>F_c_t2_c_t3</bpmn:incoming><bpmn:outgoing>F_c_t3_c_g</bpmn:outgoing></bpmn:manualTask><bpmn:exclusiveGateway id="c_g" name="¿Hubo acuerdo?"><bpmn:incoming>F_c_t3_c_g</bpmn:incoming><bpmn:outgoing>F_c_g_c_t4</bpmn:outgoing><bpmn:outgoing>F_c_g_c_t5</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="c_t4" name="Subir acta con acuerdo al expediente digital"><bpmn:incoming>F_c_g_c_t4</bpmn:incoming><bpmn:outgoing>F_c_t4_c_e1</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="c_e1" name="Acta con acuerdo"><bpmn:incoming>F_c_t4_c_e1</bpmn:incoming></bpmn:endEvent><bpmn:userTask id="c_t5" name="Subir acta de falta de acuerdo"><bpmn:incoming>F_c_g_c_t5</bpmn:incoming><bpmn:outgoing>F_c_t5_c_e2</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="c_e2" name="Acta sin acuerdo"><bpmn:incoming>F_c_t5_c_e2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_c_st_c_t1" sourceRef="c_st" targetRef="c_t1"/><bpmn:sequenceFlow id="F_c_t1_c_m1" sourceRef="c_t1" targetRef="c_m1"/><bpmn:sequenceFlow id="F_c_m1_c_t2" sourceRef="c_m1" targetRef="c_t2"/><bpmn:sequenceFlow id="F_c_t2_c_t3" sourceRef="c_t2" targetRef="c_t3"/><bpmn:sequenceFlow id="F_c_t3_c_g" sourceRef="c_t3" targetRef="c_g"/><bpmn:sequenceFlow id="F_c_g_c_t4" name="Sí" sourceRef="c_g" targetRef="c_t4"/><bpmn:sequenceFlow id="F_c_t4_c_e1" sourceRef="c_t4" targetRef="c_e1"/><bpmn:sequenceFlow id="F_c_g_c_t5" name="No" sourceRef="c_g" targetRef="c_t5"/><bpmn:sequenceFlow id="F_c_t5_c_e2" sourceRef="c_t5" targetRef="c_e2"/></bpmn:subProcess>
    <bpmn:exclusiveGateway id="g_acu" name="¿Hubo acuerdo?"><bpmn:incoming>F_sp_conc_g_acu</bpmn:incoming><bpmn:outgoing>F_g_acu_e_acu</bpmn:outgoing><bpmn:outgoing>F_g_acu_j_c</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_acu" name="Acuerdo conciliatorio (pasa a P3)"><bpmn:incoming>F_g_acu_e_acu</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_c"><bpmn:incoming>F_g_conc_j_c</bpmn:incoming><bpmn:incoming>F_g_acu_j_c</bpmn:incoming><bpmn:outgoing>F_j_c_t_tipo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_tipo" name="Seleccionar plantilla según familia de rol y tipo de escrito"><bpmn:incoming>F_j_c_t_tipo</bpmn:incoming><bpmn:outgoing>F_t_tipo_g_comp</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_comp" name="¿Alta complejidad?"><bpmn:incoming>F_t_tipo_g_comp</bpmn:incoming><bpmn:outgoing>F_g_comp_t_redA</bpmn:outgoing><bpmn:outgoing>F_g_comp_t_redP</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_redA" name="Redactar el escrito en el editor del sistema"><bpmn:incoming>F_g_comp_t_redA</bpmn:incoming><bpmn:outgoing>F_t_redA_j_red</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_redP" name="Redactar borrador con plantilla y biblioteca de jurisprudencia"><bpmn:incoming>F_g_comp_t_redP</bpmn:incoming><bpmn:outgoing>F_t_redP_j_red</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_red"><bpmn:incoming>F_t_redA_j_red</bpmn:incoming><bpmn:incoming>F_t_redP_j_red</bpmn:incoming><bpmn:incoming>F_t_corr_j_red</bpmn:incoming><bpmn:incoming>F_j_corr_j_red</bpmn:incoming><bpmn:outgoing>F_j_red_t_ver</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_ver" name="Guardar versión en el expediente digital"><bpmn:incoming>F_j_red_t_ver</bpmn:incoming><bpmn:outgoing>F_t_ver_t_rev</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_rev" name="Revisar y aprobar u observar en el panel"><bpmn:incoming>F_t_ver_t_rev</bpmn:incoming><bpmn:outgoing>F_t_rev_g_apr</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_apr" name="¿Escrito aprobado?"><bpmn:incoming>F_t_rev_g_apr</bpmn:incoming><bpmn:outgoing>F_g_apr_t_corr</bpmn:outgoing><bpmn:outgoing>F_g_apr_g_fir</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_corr" name="Corregir según observaciones"><bpmn:incoming>F_g_apr_t_corr</bpmn:incoming><bpmn:outgoing>F_t_corr_j_red</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_fir" name="¿Requiere firma del cliente?"><bpmn:incoming>F_g_apr_g_fir</bpmn:incoming><bpmn:outgoing>F_g_fir_t_firm</bpmn:outgoing><bpmn:outgoing>F_g_fir_j_fir</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_firm" name="Solicitar firma digital por el portal"><bpmn:incoming>F_g_fir_t_firm</bpmn:incoming><bpmn:outgoing>F_t_firm_t_rfir</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="t_rfir" name="Recibir escrito firmado"><bpmn:incoming>F_t_firm_t_rfir</bpmn:incoming><bpmn:outgoing>F_t_rfir_j_fir</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="j_fir"><bpmn:incoming>F_t_rfir_j_fir</bpmn:incoming><bpmn:incoming>F_g_fir_j_fir</bpmn:incoming><bpmn:outgoing>F_j_fir_g_tasa</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_tasa" name="¿Requiere tasa judicial?"><bpmn:incoming>F_j_fir_g_tasa</bpmn:incoming><bpmn:outgoing>F_g_tasa_t_tasa</bpmn:outgoing><bpmn:outgoing>F_g_tasa_j_tasa</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_tasa" name="Pagar tasa y adjuntar comprobante"><bpmn:incoming>F_g_tasa_t_tasa</bpmn:incoming><bpmn:outgoing>F_t_tasa_j_tasa</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_tasa"><bpmn:incoming>F_t_tasa_j_tasa</bpmn:incoming><bpmn:incoming>F_g_tasa_j_tasa</bpmn:incoming><bpmn:outgoing>F_j_tasa_g_modo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_modo" name="¿Modo de presentación?"><bpmn:incoming>F_j_tasa_g_modo</bpmn:incoming><bpmn:outgoing>F_g_modo_t_mpe</bpmn:outgoing><bpmn:outgoing>F_g_modo_t_fis</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_mpe" name="Presentar por Mesa de Partes Electrónica"><bpmn:incoming>F_g_modo_t_mpe</bpmn:incoming><bpmn:outgoing>F_t_mpe_j_pres</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="t_fis" name="Presentar en mesa de partes"><bpmn:incoming>F_g_modo_t_fis</bpmn:incoming><bpmn:outgoing>F_t_fis_j_pres</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_pres"><bpmn:incoming>F_t_mpe_j_pres</bpmn:incoming><bpmn:incoming>F_t_fis_j_pres</bpmn:incoming><bpmn:outgoing>F_j_pres_t_cargo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_cargo" name="Subir cargo y registrar la presentación"><bpmn:incoming>F_j_pres_t_cargo</bpmn:incoming><bpmn:outgoing>F_t_cargo_t_etapa</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_etapa" name="Actualizar etapa y publicar avance en el portal"><bpmn:incoming>F_t_cargo_t_etapa</bpmn:incoming><bpmn:outgoing>F_t_etapa_j_w</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_w"><bpmn:incoming>F_t_etapa_j_w</bpmn:incoming><bpmn:incoming>F_g_nov_j_w</bpmn:incoming><bpmn:incoming>F_j_esp_j_w</bpmn:incoming><bpmn:outgoing>F_j_w_ebg_n</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_n"><bpmn:incoming>F_j_w_ebg_n</bpmn:incoming><bpmn:outgoing>F_ebg_n_m_not</bpmn:outgoing><bpmn:outgoing>F_ebg_n_tm_sem</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_not" name="Notificación recibida (SINOE, casilla o cédula)"><bpmn:incoming>F_ebg_n_m_not</bpmn:incoming><bpmn:outgoing>F_m_not_j_n</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_not"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_sem" name="Revisión semanal programada"><bpmn:incoming>F_ebg_n_tm_sem</bpmn:incoming><bpmn:outgoing>F_tm_sem_t_cej</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_sem"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_cej" name="Revisar CEJ y casillas electrónicas"><bpmn:incoming>F_tm_sem_t_cej</bpmn:incoming><bpmn:outgoing>F_t_cej_g_nov</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_nov" name="¿Hay novedad?"><bpmn:incoming>F_t_cej_g_nov</bpmn:incoming><bpmn:outgoing>F_g_nov_j_n</bpmn:outgoing><bpmn:outgoing>F_g_nov_j_w</bpmn:outgoing></bpmn:exclusiveGateway>
