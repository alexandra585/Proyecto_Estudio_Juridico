    <bpmn:textAnnotation id="n1"><bpmn:text>Antes: plazos en agenda física. Ahora: plazos registrados con alertas automáticas.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n1" sourceRef="t_plz" targetRef="n1"/>
    <bpmn:textAnnotation id="n2"><bpmn:text>Una plantilla por familia de rol: civil activa/pasiva, penal, violencia (Ley 30364), administrativo, conciliación/arbitraje y trámite.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n2" sourceRef="t_tipo" targetRef="n2"/>
    <bpmn:textAnnotation id="n3"><bpmn:text>El cliente ve el avance en su portal sin escribir por WhatsApp.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_n3" sourceRef="t_etapa" targetRef="n3"/>
