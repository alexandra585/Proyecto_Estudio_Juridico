<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_T1" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_T1_0"><bpmn:categoryValue id="CV_T1_0" value="FASE A · Captación y agendamiento"/></bpmn:category>
  <bpmn:category id="Cat_T1_1"><bpmn:categoryValue id="CV_T1_1" value="FASE B · Consulta y propuesta"/></bpmn:category>
  <bpmn:category id="Cat_T1_2"><bpmn:categoryValue id="CV_T1_2" value="FASE C · Contratación y apertura del caso"/></bpmn:category>
  <bpmn:process id="Proc_T1" name="P1 - Captación, Consulta y Apertura del Caso (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LS_T1">
      <bpmn:lane id="L_SIS" name="Sistema Magallanes-Montero">
        <bpmn:flowNodeRef>st_web</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_vinc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_coin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_nopat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ncit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_repro</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_canc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_comp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_acep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_contra</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_segu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_segu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_arch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_contr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fdig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_caso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_port</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>st_wsp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_regp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_urg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_agen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hoy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_ag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pagc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fpre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_firma</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_adel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ficha</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ABO" name="Abogado especialista">
        <bpmn:flowNodeRef>t_revc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_aten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_resu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_abs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_prop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rol</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="st_web" name="Consulta enviada desde la Landing Page"><bpmn:outgoing>F_st_web_j0</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_web"/></bpmn:startEvent>
    <bpmn:startEvent id="st_wsp" name="Consulta por WhatsApp o llamada"><bpmn:outgoing>F_st_wsp_t_regp</bpmn:outgoing><bpmn:messageEventDefinition id="ED_st_wsp"/></bpmn:startEvent>
    <bpmn:userTask id="t_regp" name="Registrar consulta en el panel"><bpmn:incoming>F_st_wsp_t_regp</bpmn:incoming><bpmn:outgoing>F_t_regp_j0</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j0"><bpmn:incoming>F_st_web_j0</bpmn:incoming><bpmn:incoming>F_t_regp_j0</bpmn:incoming><bpmn:outgoing>F_j0_t_reg</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_reg" name="Registrar consulta y buscar cliente por DNI/RUC"><bpmn:incoming>F_j0_t_reg</bpmn:incoming><bpmn:outgoing>F_t_reg_g_rec</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_rec" name="¿Cliente registrado?"><bpmn:incoming>F_t_reg_g_rec</bpmn:incoming><bpmn:outgoing>F_g_rec_t_vinc</bpmn:outgoing><bpmn:outgoing>F_g_rec_t_pros</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_vinc" name="Vincular al historial del cliente (recurrente)"><bpmn:incoming>F_g_rec_t_vinc</bpmn:incoming><bpmn:outgoing>F_t_vinc_j_rec</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_pros" name="Crear ficha de prospecto"><bpmn:incoming>F_g_rec_t_pros</bpmn:incoming><bpmn:outgoing>F_t_pros_j_rec</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_rec"><bpmn:incoming>F_t_vinc_j_rec</bpmn:incoming><bpmn:incoming>F_t_pros_j_rec</bpmn:incoming><bpmn:outgoing>F_j_rec_t_ack</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_ack" name="Enviar confirmación por WhatsApp y correo"><bpmn:incoming>F_j_rec_t_ack</bpmn:incoming><bpmn:outgoing>F_t_ack_t_conf</bpmn:outgoing></bpmn:sendTask>
    <bpmn:serviceTask id="t_conf" name="Verificar conflicto de interés (contrapartes vs. casos)"><bpmn:incoming>F_t_ack_t_conf</bpmn:incoming><bpmn:outgoing>F_t_conf_g_coin</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_coin" name="¿Hay coincidencia?"><bpmn:incoming>F_t_conf_g_coin</bpmn:incoming><bpmn:outgoing>F_g_coin_t_revc</bpmn:outgoing><bpmn:outgoing>F_g_coin_j_ok</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_revc" name="Revisar la coincidencia detectada"><bpmn:incoming>F_g_coin_t_revc</bpmn:incoming><bpmn:outgoing>F_t_revc_g_conf</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_conf" name="¿Conflicto confirmado?"><bpmn:incoming>F_t_revc_g_conf</bpmn:incoming><bpmn:outgoing>F_g_conf_t_nopat</bpmn:outgoing><bpmn:outgoing>F_g_conf_j_ok</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_nopat" name="Notificar que no se puede patrocinar"><bpmn:incoming>F_g_conf_t_nopat</bpmn:incoming><bpmn:outgoing>F_t_nopat_e_conf</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e_conf" name="Consulta rechazada por conflicto"><bpmn:incoming>F_t_nopat_e_conf</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_ok"><bpmn:incoming>F_g_coin_j_ok</bpmn:incoming><bpmn:incoming>F_g_conf_j_ok</bpmn:incoming><bpmn:outgoing>F_j_ok_g_urg</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_urg" name="¿Caso urgente?"><bpmn:incoming>F_j_ok_g_urg</bpmn:incoming><bpmn:outgoing>F_g_urg_t_agen</bpmn:outgoing><bpmn:outgoing>F_g_urg_t_hoy</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_agen" name="Agendar cita en el calendario según disponibilidad del especialista"><bpmn:incoming>F_g_urg_t_agen</bpmn:incoming><bpmn:outgoing>F_t_agen_j_ag</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_hoy" name="Agendar cita prioritaria el mismo día"><bpmn:incoming>F_g_urg_t_hoy</bpmn:incoming><bpmn:outgoing>F_t_hoy_j_ag</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_ag"><bpmn:incoming>F_t_agen_j_ag</bpmn:incoming><bpmn:incoming>F_t_hoy_j_ag</bpmn:incoming><bpmn:outgoing>F_j_ag_t_ncit</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_ncit" name="Enviar cita programada (presencial o virtual)"><bpmn:incoming>F_j_ag_t_ncit</bpmn:incoming><bpmn:incoming>F_m_repro_t_ncit</bpmn:incoming><bpmn:outgoing>F_t_ncit_tm_24</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="tm_24" name="24 horas antes de la cita"><bpmn:incoming>F_t_ncit_tm_24</bpmn:incoming><bpmn:outgoing>F_tm_24_t_rec</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_24"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_rec" name="Enviar recordatorio automático"><bpmn:incoming>F_tm_24_t_rec</bpmn:incoming><bpmn:outgoing>F_t_rec_ebg1</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="ebg1"><bpmn:incoming>F_t_rec_ebg1</bpmn:incoming><bpmn:outgoing>F_ebg1_m_conf</bpmn:outgoing><bpmn:outgoing>F_ebg1_m_repro</bpmn:outgoing><bpmn:outgoing>F_ebg1_m_canc</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_conf" name="Cliente confirma"><bpmn:incoming>F_ebg1_m_conf</bpmn:incoming><bpmn:outgoing>F_m_conf_t_aten</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_conf"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_repro" name="Cliente reprograma desde el enlace"><bpmn:incoming>F_ebg1_m_repro</bpmn:incoming><bpmn:outgoing>F_m_repro_t_ncit</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_repro"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_canc" name="Cliente cancela"><bpmn:incoming>F_ebg1_m_canc</bpmn:incoming><bpmn:outgoing>F_m_canc_e_canc</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_canc"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_canc" name="Cita cancelada (queda registrada)"><bpmn:incoming>F_m_canc_e_canc</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t_aten" name="Atender la consulta (presencial o videollamada)"><bpmn:incoming>F_m_conf_t_aten</bpmn:incoming><bpmn:outgoing>F_t_aten_t_resu</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_resu" name="Registrar resumen, materia y tipo de encargo en el panel"><bpmn:incoming>F_t_aten_t_resu</bpmn:incoming><bpmn:outgoing>F_t_resu_t_comp</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_comp" name="Emitir comprobante de la consulta según tipo de cliente"><bpmn:incoming>F_t_resu_t_comp</bpmn:incoming><bpmn:outgoing>F_t_comp_t_pagc</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:receiveTask id="t_pagc" name="Registrar pago de la consulta"><bpmn:incoming>F_t_comp_t_pagc</bpmn:incoming><bpmn:outgoing>F_t_pagc_g_enc</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="g_enc" name="¿Requiere patrocinio o trámite?"><bpmn:incoming>F_t_pagc_g_enc</bpmn:incoming><bpmn:outgoing>F_g_enc_e_abs</bpmn:outgoing><bpmn:outgoing>F_g_enc_t_prop</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="e_abs" name="Consulta absuelta"><bpmn:incoming>F_g_enc_e_abs</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t_prop" name="Generar propuesta de honorarios desde plantilla"><bpmn:incoming>F_g_enc_t_prop</bpmn:incoming><bpmn:outgoing>F_t_prop_j_p</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_p"><bpmn:incoming>F_t_prop_j_p</bpmn:incoming><bpmn:incoming>F_t_ver_j_p</bpmn:incoming><bpmn:incoming>F_g_segu_j_p</bpmn:incoming><bpmn:outgoing>F_j_p_t_envp</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_envp" name="Enviar propuesta al cliente"><bpmn:incoming>F_j_p_t_envp</bpmn:incoming><bpmn:outgoing>F_t_envp_ebg2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:eventBasedGateway id="ebg2"><bpmn:incoming>F_t_envp_ebg2</bpmn:incoming><bpmn:outgoing>F_ebg2_m_acep</bpmn:outgoing><bpmn:outgoing>F_ebg2_m_contra</bpmn:outgoing><bpmn:outgoing>F_ebg2_m_rech</bpmn:outgoing><bpmn:outgoing>F_ebg2_tm_5</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_acep" name="Cliente acepta"><bpmn:incoming>F_ebg2_m_acep</bpmn:incoming><bpmn:outgoing>F_m_acep_t_contr</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_acep"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_contra" name="Cliente envía contraoferta"><bpmn:incoming>F_ebg2_m_contra</bpmn:incoming><bpmn:outgoing>F_m_contra_t_ver</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_contra"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="m_rech" name="Cliente rechaza"><bpmn:incoming>F_ebg2_m_rech</bpmn:incoming><bpmn:outgoing>F_m_rech_e_rech</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_rech"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_rech" name="Propuesta rechazada"><bpmn:incoming>F_m_rech_e_rech</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm_5" name="5 días sin respuesta"><bpmn:incoming>F_ebg2_tm_5</bpmn:incoming><bpmn:outgoing>F_tm_5_t_segu</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_5"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_segu" name="Enviar recordatorio de la propuesta"><bpmn:incoming>F_tm_5_t_segu</bpmn:incoming><bpmn:outgoing>F_t_segu_g_segu</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_segu" name="¿Menos de 2 recordatorios?"><bpmn:incoming>F_t_segu_g_segu</bpmn:incoming><bpmn:outgoing>F_g_segu_t_arch</bpmn:outgoing><bpmn:outgoing>F_g_segu_j_p</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_arch" name="Archivar prospecto"><bpmn:incoming>F_g_segu_t_arch</bpmn:incoming><bpmn:outgoing>F_t_arch_e_arch</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e_arch" name="Prospecto archivado"><bpmn:incoming>F_t_arch_e_arch</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t_ver" name="Ajustar propuesta (nueva versión)"><bpmn:incoming>F_m_contra_t_ver</bpmn:incoming><bpmn:outgoing>F_t_ver_j_p</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_contr" name="Generar contrato y cronograma de cuotas"><bpmn:incoming>F_m_acep_t_contr</bpmn:incoming><bpmn:outgoing>F_t_contr_t_envc</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="t_envc" name="Enviar contrato al portal y crear acceso del cliente"><bpmn:incoming>F_t_contr_t_envc</bpmn:incoming><bpmn:outgoing>F_t_envc_g_firma</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_firma" name="¿Modo de firma?"><bpmn:incoming>F_t_envc_g_firma</bpmn:incoming><bpmn:outgoing>F_g_firma_t_fdig</bpmn:outgoing><bpmn:outgoing>F_g_firma_t_fpre</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="t_fdig" name="Recibir contrato firmado digitalmente"><bpmn:incoming>F_g_firma_t_fdig</bpmn:incoming><bpmn:outgoing>F_t_fdig_j_firma</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:manualTask id="t_fpre" name="Firmar en oficina y escanear al expediente"><bpmn:incoming>F_g_firma_t_fpre</bpmn:incoming><bpmn:outgoing>F_t_fpre_j_firma</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="j_firma"><bpmn:incoming>F_t_fdig_j_firma</bpmn:incoming><bpmn:incoming>F_t_fpre_j_firma</bpmn:incoming><bpmn:outgoing>F_j_firma_t_adel</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="t_adel" name="Registrar pago del adelanto (cuota 1)"><bpmn:incoming>F_j_firma_t_adel</bpmn:incoming><bpmn:outgoing>F_t_adel_t_ficha</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:userTask id="t_ficha" name="Completar ficha según tipo de cliente"><bpmn:incoming>F_t_adel_t_ficha</bpmn:incoming><bpmn:outgoing>F_t_ficha_t_rol</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_rol" name="Registrar partes, rol procesal y materia"><bpmn:incoming>F_t_ficha_t_rol</bpmn:incoming><bpmn:outgoing>F_t_rol_t_caso</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_caso" name="Abrir caso y crear expediente digital"><bpmn:incoming>F_t_rol_t_caso</bpmn:incoming><bpmn:outgoing>F_t_caso_t_asig</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_asig" name="Asignar especialista y notificar al equipo"><bpmn:incoming>F_t_caso_t_asig</bpmn:incoming><bpmn:outgoing>F_t_asig_t_port</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:sendTask id="t_port" name="Avisar al cliente la apertura del expediente en su portal"><bpmn:incoming>F_t_asig_t_port</bpmn:incoming><bpmn:outgoing>F_t_port_e_ok</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e_ok" name="Caso aperturado (pasa a P2)"><bpmn:incoming>F_t_port_e_ok</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F_st_web_j0" sourceRef="st_web" targetRef="j0"/>
    <bpmn:sequenceFlow id="F_st_wsp_t_regp" sourceRef="st_wsp" targetRef="t_regp"/>
    <bpmn:sequenceFlow id="F_t_regp_j0" sourceRef="t_regp" targetRef="j0"/>
    <bpmn:sequenceFlow id="F_j0_t_reg" sourceRef="j0" targetRef="t_reg"/>
    <bpmn:sequenceFlow id="F_t_reg_g_rec" sourceRef="t_reg" targetRef="g_rec"/>
    <bpmn:sequenceFlow id="F_g_rec_t_vinc" name="Sí" sourceRef="g_rec" targetRef="t_vinc"/>
