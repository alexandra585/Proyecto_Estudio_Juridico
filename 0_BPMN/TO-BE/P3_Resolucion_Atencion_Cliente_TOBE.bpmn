<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_T3" targetNamespace="http://magallanes-montero.pe/bpmn" exporter="Claude" exporterVersion="1.0">
  <bpmn:category id="Cat_T3_0"><bpmn:categoryValue id="CV_T3_0" value="FASE 1 · Análisis y comunicación"/></bpmn:category>
  <bpmn:category id="Cat_T3_1"><bpmn:categoryValue id="CV_T3_1" value="FASE 2 · Impugnación y ejecución"/></bpmn:category>
  <bpmn:category id="Cat_T3_2"><bpmn:categoryValue id="CV_T3_2" value="FASE 3 · Liquidación y cobro"/></bpmn:category>
  <bpmn:category id="Cat_T3_3"><bpmn:categoryValue id="CV_T3_3" value="FASE 4 · Cierre y post-servicio"/></bpmn:category>
  <bpmn:process id="Proc_T3" name="P3 - Resolución del Caso y Atención al Cliente (TO-BE)" isExecutable="false">
    <bpmn:laneSet id="LS_T3">
      <bpmn:lane id="L_SIS" name="Sistema Magallanes-Montero">
        <bpmn:flowNodeRef>t_not</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_saldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_lit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_l</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_bol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_fac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_facp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_tipo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_envc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_pag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_p</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_frac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cob</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cie</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_enc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_genc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_nue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_nue</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SEC" name="Secretaria">
        <bpmn:flowNodeRef>t_conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_regp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_coord</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_entr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_PRA" name="Practicante">
        <bpmn:flowNodeRef>t_orig</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ABO" name="Abogado especialista">
        <bpmn:flowNodeRef>st1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>st2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>st3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_com</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_apc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_abs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ebg_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_ape</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tm_a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_hon2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ac2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_apel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_2i</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_cons</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ejec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_ejec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>j_ej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_liq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_deu</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="st1" name="Resolución final notificada (de P2)"><bpmn:outgoing>F_st1_j0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="st2" name="Acuerdo conciliatorio (de P2)"><bpmn:outgoing>F_st2_j0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:startEvent id="st3" name="Desistimiento o trámite concluido (de P2)"><bpmn:outgoing>F_st3_j0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="j0"><bpmn:incoming>F_st1_j0</bpmn:incoming><bpmn:incoming>F_st2_j0</bpmn:incoming><bpmn:incoming>F_st3_j0</bpmn:incoming><bpmn:outgoing>F_j0_t_res</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_res" name="Registrar el resultado en el sistema"><bpmn:incoming>F_j0_t_res</bpmn:incoming><bpmn:outgoing>F_t_res_t_not</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_not" name="Notificar resultado y agendar reunión con el cliente"><bpmn:incoming>F_t_res_t_not</bpmn:incoming><bpmn:outgoing>F_t_not_t_com</bpmn:outgoing></bpmn:sendTask>
    <bpmn:manualTask id="t_com" name="Explicar el resultado al cliente"><bpmn:incoming>F_t_not_t_com</bpmn:incoming><bpmn:outgoing>F_t_com_g_res</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="g_res" name="¿Resultado?"><bpmn:incoming>F_t_com_g_res</bpmn:incoming><bpmn:outgoing>F_g_res_ebg_f</bpmn:outgoing><bpmn:outgoing>F_g_res_ebg_a</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_f"><bpmn:incoming>F_g_res_ebg_f</bpmn:incoming><bpmn:outgoing>F_ebg_f_m_apc</bpmn:outgoing><bpmn:outgoing>F_ebg_f_tm_f</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_apc" name="Contraparte apela"><bpmn:incoming>F_ebg_f_m_apc</bpmn:incoming><bpmn:outgoing>F_m_apc_e_abs</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_apc"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="e_abs" name="Absolver apelación (regresa a P2)"><bpmn:incoming>F_m_apc_e_abs</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="tm_f" name="Vence plazo sin apelación (alerta)"><bpmn:incoming>F_ebg_f_tm_f</bpmn:incoming><bpmn:outgoing>F_tm_f_j_cons</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_f"/></bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="ebg_a"><bpmn:incoming>F_g_res_ebg_a</bpmn:incoming><bpmn:outgoing>F_ebg_a_m_ape</bpmn:outgoing><bpmn:outgoing>F_ebg_a_tm_a</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_ape" name="Cliente decide apelar (portal)"><bpmn:incoming>F_ebg_a_m_ape</bpmn:incoming><bpmn:outgoing>F_m_ape_t_hon2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_ape"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_a" name="Vence plazo de apelación (alerta)"><bpmn:incoming>F_ebg_a_tm_a</bpmn:incoming><bpmn:outgoing>F_tm_a_j_cons</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_a"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_hon2" name="Proponer honorarios de 2.ª instancia"><bpmn:incoming>F_m_ape_t_hon2</bpmn:incoming><bpmn:outgoing>F_t_hon2_g_ac2</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_ac2" name="¿Acepta?"><bpmn:incoming>F_t_hon2_g_ac2</bpmn:incoming><bpmn:outgoing>F_g_ac2_t_apel</bpmn:outgoing><bpmn:outgoing>F_g_ac2_j_cons</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_apel" name="Presentar recurso de apelación"><bpmn:incoming>F_g_ac2_t_apel</bpmn:incoming><bpmn:outgoing>F_t_apel_e_2i</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="e_2i" name="Derivado a 2.ª instancia (regresa a P2)"><bpmn:incoming>F_t_apel_e_2i</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="j_cons"><bpmn:incoming>F_tm_f_j_cons</bpmn:incoming><bpmn:incoming>F_g_ac2_j_cons</bpmn:incoming><bpmn:incoming>F_tm_a_j_cons</bpmn:incoming><bpmn:outgoing>F_j_cons_g_ejec</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_ejec" name="¿Requiere ejecución?"><bpmn:incoming>F_j_cons_g_ejec</bpmn:incoming><bpmn:outgoing>F_g_ejec_sp_ejec</bpmn:outgoing><bpmn:outgoing>F_g_ejec_j_ej</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="sp_ejec" name="Ejecución de sentencia"><bpmn:incoming>F_g_ejec_sp_ejec</bpmn:incoming><bpmn:outgoing>F_sp_ejec_j_ej</bpmn:outgoing><bpmn:startEvent id="x_st" name="Inicio"><bpmn:outgoing>F_x_st_x_t1</bpmn:outgoing></bpmn:startEvent><bpmn:sendTask id="x_t1" name="Presentar solicitud de ejecución"><bpmn:incoming>F_x_st_x_t1</bpmn:incoming><bpmn:outgoing>F_x_t1_x_t2</bpmn:outgoing></bpmn:sendTask><bpmn:serviceTask id="x_t2" name="Registrar plazo de cumplimiento y alerta"><bpmn:incoming>F_x_t1_x_t2</bpmn:incoming><bpmn:outgoing>F_x_t2_x_tm</bpmn:outgoing></bpmn:serviceTask><bpmn:intermediateCatchEvent id="x_tm" name="Vence plazo de cumplimiento"><bpmn:incoming>F_x_t2_x_tm</bpmn:incoming><bpmn:outgoing>F_x_tm_x_g</bpmn:outgoing><bpmn:timerEventDefinition id="ED_x_tm"/></bpmn:intermediateCatchEvent><bpmn:exclusiveGateway id="x_g" name="¿El obligado cumplió?"><bpmn:incoming>F_x_tm_x_g</bpmn:incoming><bpmn:outgoing>F_x_g_x_t3</bpmn:outgoing><bpmn:outgoing>F_x_g_x_t4</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:userTask id="x_t3" name="Registrar cobro, entrega o inscripción"><bpmn:incoming>F_x_g_x_t3</bpmn:incoming><bpmn:outgoing>F_x_t3_x_e1</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="x_e1" name="Sentencia ejecutada"><bpmn:incoming>F_x_t3_x_e1</bpmn:incoming></bpmn:endEvent><bpmn:sendTask id="x_t4" name="Solicitar embargo u otras medidas"><bpmn:incoming>F_x_g_x_t4</bpmn:incoming><bpmn:outgoing>F_x_t4_x_t5</bpmn:outgoing></bpmn:sendTask><bpmn:userTask id="x_t5" name="Registrar resultado de las medidas"><bpmn:incoming>F_x_t4_x_t5</bpmn:incoming><bpmn:outgoing>F_x_t5_x_e2</bpmn:outgoing></bpmn:userTask><bpmn:endEvent id="x_e2" name="Ejecución forzada concluida"><bpmn:incoming>F_x_t5_x_e2</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="F_x_st_x_t1" sourceRef="x_st" targetRef="x_t1"/><bpmn:sequenceFlow id="F_x_t1_x_t2" sourceRef="x_t1" targetRef="x_t2"/><bpmn:sequenceFlow id="F_x_t2_x_tm" sourceRef="x_t2" targetRef="x_tm"/><bpmn:sequenceFlow id="F_x_tm_x_g" sourceRef="x_tm" targetRef="x_g"/><bpmn:sequenceFlow id="F_x_g_x_t3" name="Sí" sourceRef="x_g" targetRef="x_t3"/><bpmn:sequenceFlow id="F_x_t3_x_e1" sourceRef="x_t3" targetRef="x_e1"/><bpmn:sequenceFlow id="F_x_g_x_t4" name="No" sourceRef="x_g" targetRef="x_t4"/><bpmn:sequenceFlow id="F_x_t4_x_t5" sourceRef="x_t4" targetRef="x_t5"/><bpmn:sequenceFlow id="F_x_t5_x_e2" sourceRef="x_t5" targetRef="x_e2"/></bpmn:subProcess>
    <bpmn:exclusiveGateway id="j_ej"><bpmn:incoming>F_g_ejec_j_ej</bpmn:incoming><bpmn:incoming>F_sp_ejec_j_ej</bpmn:incoming><bpmn:outgoing>F_j_ej_t_saldo</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_saldo" name="Calcular saldo pendiente del caso"><bpmn:incoming>F_j_ej_t_saldo</bpmn:incoming><bpmn:outgoing>F_t_saldo_g_lit</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_lit" name="¿Cuota litis pactada y monto cobrado?"><bpmn:incoming>F_t_saldo_g_lit</bpmn:incoming><bpmn:outgoing>F_g_lit_t_lit</bpmn:outgoing><bpmn:outgoing>F_g_lit_j_l</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_lit" name="Calcular cuota litis (% sobre lo obtenido)"><bpmn:incoming>F_g_lit_t_lit</bpmn:incoming><bpmn:outgoing>F_t_lit_j_l</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_l"><bpmn:incoming>F_g_lit_j_l</bpmn:incoming><bpmn:incoming>F_t_lit_j_l</bpmn:incoming><bpmn:outgoing>F_j_l_t_liq</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_liq" name="Validar la liquidación final"><bpmn:incoming>F_j_l_t_liq</bpmn:incoming><bpmn:outgoing>F_t_liq_t_envl</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_envl" name="Enviar liquidación al cliente"><bpmn:incoming>F_t_liq_t_envl</bpmn:incoming><bpmn:outgoing>F_t_envl_g_tipo</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_tipo" name="¿Tipo de cliente?"><bpmn:incoming>F_t_envl_g_tipo</bpmn:incoming><bpmn:outgoing>F_g_tipo_t_bol</bpmn:outgoing><bpmn:outgoing>F_g_tipo_t_fac</bpmn:outgoing><bpmn:outgoing>F_g_tipo_t_conf</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="t_conf" name="Registrar conformidad del servicio"><bpmn:incoming>F_g_tipo_t_conf</bpmn:incoming><bpmn:outgoing>F_t_conf_t_facp</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:serviceTask id="t_bol" name="Emitir boleta electrónica"><bpmn:incoming>F_g_tipo_t_bol</bpmn:incoming><bpmn:outgoing>F_t_bol_j_tipo</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_fac" name="Emitir factura (detracción si corresponde)"><bpmn:incoming>F_g_tipo_t_fac</bpmn:incoming><bpmn:outgoing>F_t_fac_j_tipo</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_facp" name="Emitir factura a la entidad"><bpmn:incoming>F_t_conf_t_facp</bpmn:incoming><bpmn:outgoing>F_t_facp_j_tipo</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="j_tipo"><bpmn:incoming>F_t_bol_j_tipo</bpmn:incoming><bpmn:incoming>F_t_fac_j_tipo</bpmn:incoming><bpmn:incoming>F_t_facp_j_tipo</bpmn:incoming><bpmn:outgoing>F_j_tipo_t_envc</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_envc" name="Enviar comprobante electrónico"><bpmn:incoming>F_j_tipo_t_envc</bpmn:incoming><bpmn:outgoing>F_t_envc_j_pag</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="j_pag"><bpmn:incoming>F_t_envc_j_pag</bpmn:incoming><bpmn:incoming>F_g_rec_j_pag</bpmn:incoming><bpmn:outgoing>F_j_pag_ebg_p</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="ebg_p"><bpmn:incoming>F_j_pag_ebg_p</bpmn:incoming><bpmn:outgoing>F_ebg_p_m_pago</bpmn:outgoing><bpmn:outgoing>F_ebg_p_tm_15</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="m_pago" name="Pago recibido (transferencia, Yape o tarjeta)"><bpmn:incoming>F_ebg_p_m_pago</bpmn:incoming><bpmn:outgoing>F_m_pago_t_regp</bpmn:outgoing><bpmn:messageEventDefinition id="ED_m_pago"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="tm_15" name="15 días sin pago"><bpmn:incoming>F_ebg_p_tm_15</bpmn:incoming><bpmn:outgoing>F_tm_15_t_recp</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_15"/></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="t_recp" name="Enviar recordatorio de pago"><bpmn:incoming>F_tm_15_t_recp</bpmn:incoming><bpmn:outgoing>F_t_recp_g_rec</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="g_rec" name="¿Menos de 3 recordatorios?"><bpmn:incoming>F_t_recp_g_rec</bpmn:incoming><bpmn:outgoing>F_g_rec_j_pag</bpmn:outgoing><bpmn:outgoing>F_g_rec_g_dec</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_regp" name="Validar y registrar el pago"><bpmn:incoming>F_m_pago_t_regp</bpmn:incoming><bpmn:outgoing>F_t_regp_t_act</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_act" name="Actualizar saldo y enviar constancia"><bpmn:incoming>F_t_regp_t_act</bpmn:incoming><bpmn:outgoing>F_t_act_j_cob</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g_dec" name="¿Fraccionar la deuda?"><bpmn:incoming>F_g_rec_g_dec</bpmn:incoming><bpmn:outgoing>F_g_dec_t_frac</bpmn:outgoing><bpmn:outgoing>F_g_dec_t_deu</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_frac" name="Generar nuevas cuotas (fraccionamiento)"><bpmn:incoming>F_g_dec_t_frac</bpmn:incoming><bpmn:outgoing>F_t_frac_j_cob</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_deu" name="Registrar deuda pendiente"><bpmn:incoming>F_g_dec_t_deu</bpmn:incoming><bpmn:outgoing>F_t_deu_j_cob</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="j_cob"><bpmn:incoming>F_t_act_j_cob</bpmn:incoming><bpmn:incoming>F_t_frac_j_cob</bpmn:incoming><bpmn:incoming>F_t_deu_j_cob</bpmn:incoming><bpmn:outgoing>F_j_cob_t_orig</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="t_orig" name="Preparar originales y cargo de devolución"><bpmn:incoming>F_j_cob_t_orig</bpmn:incoming><bpmn:outgoing>F_t_orig_t_coord</bpmn:outgoing></bpmn:userTask>
    <bpmn:sendTask id="t_coord" name="Coordinar fecha de entrega"><bpmn:incoming>F_t_orig_t_coord</bpmn:incoming><bpmn:outgoing>F_t_coord_t_entr</bpmn:outgoing></bpmn:sendTask>
    <bpmn:receiveTask id="t_entr" name="Entregar documentos y registrar cargo firmado"><bpmn:incoming>F_t_coord_t_entr</bpmn:incoming><bpmn:outgoing>F_t_entr_t_cie</bpmn:outgoing></bpmn:receiveTask>
