    <bpmn:sendTask id="t_enc" name="Enviar encuesta de satisfacción"><bpmn:incoming>F_t_cie_t_enc</bpmn:incoming><bpmn:outgoing>F_t_enc_ebg_e</bpmn:outgoing></bpmn:sendTask>
