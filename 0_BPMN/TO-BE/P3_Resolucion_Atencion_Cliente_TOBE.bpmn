    <bpmn:intermediateCatchEvent id="tm_7" name="7 días sin respuesta"><bpmn:incoming>F_ebg_e_tm_7</bpmn:incoming><bpmn:outgoing>F_tm_7_j_e</bpmn:outgoing><bpmn:timerEventDefinition id="ED_tm_7"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="t_genc" name="Guardar respuestas y actualizar dashboard"><bpmn:incoming>F_m_enc_t_genc</bpmn:incoming><bpmn:outgoing>F_t_genc_j_e</bpmn:outgoing></bpmn:serviceTask>
