        </mxCell>
        <mxCell id="c90609" parent="r90607" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;overflow=hidden;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;fontStyle=0;" value="ultimo_numero" vertex="1">
