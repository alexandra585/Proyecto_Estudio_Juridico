# =====================================================================
# PLANTILLA del archivo .env  (cópiela como ".env" en esta misma carpeta y ponga sus datos)
# El .env NO se sube a GitHub (tiene la contraseña y el puerto de SU computadora).
# Formato: CLAVE=valor  (sin comillas y sin espacios alrededor del =)
# =====================================================================

# --- SQL Server ---
# Servidor: localhost si SQL Server está en la misma PC.
DB_HOST=localhost
# Puerto TCP de SU instancia. Se averigua en SSMS con:
#   EXEC xp_readerrorlog 0, 1, N'Server is listening on';
# (1433 es el de la instancia por defecto; una instancia con nombre suele tener otro, p. ej. 55448)
DB_PORT=1433
# Base de datos creada con los scripts de 1_SQL_Server
DB_NAME=magallanes_montero_prueba36
# Usuario de SQL Server que usa la aplicación (lo crea sql/01_preparar_base_para_la_web.sql)
DB_USER=app_magallanes
DB_PASSWORD=Magallanes2026!

# --- MongoDB ---
# Local (MongoDB Community + Compass):
MONGO_URI=mongodb://localhost:27017/magallanes_montero?serverSelectionTimeoutMS=2000
# En la nube (MongoDB Atlas), por ejemplo:
# MONGO_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/magallanes_montero

# --- Aplicación web ---
APP_PORT=8080
